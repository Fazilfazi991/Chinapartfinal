  "components": [
    {
      "name": "CPS Primary Action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Public action with immediate focus and restrained hover/press feedback.",
      "html": "<button class=\"ds-button-primary\" type=\"button\">Find Your Part <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10M7 17 17 7\"/></svg></button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:16px;min-height:50px;padding:14px 22px;font:750 14px Manrope,sans-serif;border-radius:4px;border:0;cursor:pointer;background:#ffcc05;color:#20221f;transition:background-color 160ms ease-out,transform 120ms ease-out}.ds-button-primary:hover{background:#eabc00}.ds-button-primary:focus-visible{outline:3px solid #aa3023;outline-offset:4px}.ds-button-primary:active{transform:scale(.98)}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}"
    },
    {
      "name": "CPS Outline Action",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Public action with immediate focus and restrained hover/press feedback.",
      "html": "<button class=\"ds-button-outline\" type=\"button\">Send Your Enquiry <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10M7 17 17 7\"/></svg></button>",
      "css": ".ds-button-outline{display:inline-flex;align-items:center;justify-content:center;gap:16px;min-height:50px;padding:14px 22px;font:750 14px Manrope,sans-serif;border-radius:4px;border:1px solid #96988f;cursor:pointer;background:transparent;color:#20221f;transition:background-color 160ms ease-out,transform 120ms ease-out}.ds-button-outline:hover{background:#eeede7}.ds-button-outline:focus-visible{outline:3px solid #aa3023;outline-offset:4px}.ds-button-outline:active{transform:scale(.98)}@media(prefers-reduced-motion:reduce){.ds-button-outline{transition:none}}"
    },
    {
      "name": "CPS Dark Action",
      "kind": "button",
      "refersTo": "button-dark",
      "description": "Public action with immediate focus and restrained hover/press feedback.",
      "html": "<button class=\"ds-button-dark\" type=\"button\">Talk to a Technical Expert <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10M7 17 17 7\"/></svg></button>",
      "css": ".ds-button-dark{display:inline-flex;align-items:center;justify-content:center;gap:16px;min-height:50px;padding:14px 22px;font:750 14px Manrope,sans-serif;border-radius:4px;border:0;cursor:pointer;background:#20221f;color:#fff;transition:background-color 160ms ease-out,transform 120ms ease-out}.ds-button-dark:hover{background:#383b33}.ds-button-dark:focus-visible{outline:3px solid #aa3023;outline-offset:4px}.ds-button-dark:active{transform:scale(.98)}@media(prefers-reduced-motion:reduce){.ds-button-dark{transition:none}}"
    },
    {
      "name": "Request Primary Action",
      "kind": "button",
      "refersTo": "button-request-primary",
      "description": "Warmer task action; disabled and pending presentation uses the same control.",
      "html": "<button type=\"button\" class=\"ds-request-primary\">Continue</button>",
      "css": ".ds-request-primary{padding:12px 18px;border:1px solid #856005;background:var(--yellow,#f5b512);color:var(--ink,#111315);border-radius:4px;font:700 16px/1.6 Manrope,Arial,sans-serif;cursor:pointer}.ds-request-primary:hover{background:#e5a710}.ds-request-primary:focus-visible{outline:3px solid var(--red,#b51621);outline-offset:4px}.ds-request-primary:disabled{opacity:.55;cursor:not-allowed}"
    },
    {
      "name": "Find Part Field",
      "kind": "input",
      "refersTo": "input-find",
      "description": "Homepage white field with a label above and a red focus outline.",
      "html": "<div class=\"ds-find-field\"><label for=\"ds-find-oem\">OEM / OE / part number <span>(if known)</span></label><input id=\"ds-find-oem\" placeholder=\"Copy the number exactly\" /></div>",
      "css": ".ds-find-field{font-family:Manrope,sans-serif;color:#20221f}.ds-find-field label{display:block;font-size:13px;font-weight:700;line-height:1.6;margin-bottom:8px}.ds-find-field label span{font-weight:400;color:#595c55}.ds-find-field input{width:100%;border:1px solid #9c9f93;background:#fff;color:#20221f;font:400 15px/normal Manrope,sans-serif;min-height:48px;padding:12px;border-radius:4px;caret-color:#b92f20}.ds-find-field input::placeholder{color:#62665b;opacity:1}.ds-find-field input:focus{outline:2px solid #aa3023;outline-offset:2px}"
    },
    {
      "name": "Request Field",
      "kind": "input",
      "refersTo": "input-request",
      "description": "Task field with optional annotation, invalid stroke and associated error copy.",
      "html": "<div class=\"ds-request-field\"><label for=\"ds-request-email\">Email <span>(optional)</span></label><input id=\"ds-request-email\" type=\"email\" aria-invalid=\"true\" aria-describedby=\"ds-request-email-error\" value=\"synthetic-invalid\"/><p id=\"ds-request-email-error\">Enter a valid email address.</p></div>",
      "css": ".ds-request-field{color:var(--ink,#111315);font:400 16px/1.6 Manrope,Arial,sans-serif}.ds-request-field label{display:block;font-weight:700;margin-bottom:8px}.ds-request-field label span{font-size:13px;font-weight:400;color:#4a4e52}.ds-request-field input{width:100%;font:inherit;padding:12px;border:1px solid #898e91;background:#fff;border-radius:4px;caret-color:#aa3023}.ds-request-field input[aria-invalid=true]{border:2px solid #a10e1b}.ds-request-field input:focus-visible{outline:3px solid var(--red,#b51621);outline-offset:4px}.ds-request-field p{color:#a10e1b;font-size:14px;margin:6px 0}"
    },
    {
      "name": "Public Navigation",
      "kind": "nav",
      "refersTo": "navigation-public",
      "description": "Two-level white header: actual requirement GET entry and route navigation; menu below 1150px.",
      "html": "<nav class=\"ds-nav\"><div class=\"ds-main\"><strong>China Parts Shop</strong><span class=\"ds-entry\">Describe your requirement</span><a href=\"#enquiry\">Send Your Enquiry</a></div><div class=\"ds-links\"><a href=\"#home\" aria-current=\"page\">Home</a><a href=\"#find\">Find Your Part</a><a href=\"#categories\">Categories</a></div></nav>",
      "css": ".ds-nav{background:#fff;color:#20221f;font:650 13px Manrope,sans-serif;border-bottom:1px solid #dedfd7}.ds-main{display:flex;gap:24px;align-items:center;min-height:88px;padding:16px 32px}.ds-entry{flex:1;background:#faf9f5;border:1px solid #d9dbd3;border-radius:4px;padding:14px;font-size:12px}.ds-main>a{background:#ffcc05;padding:12px 16px;border-radius:4px}.ds-links{display:flex;gap:40px;justify-content:center;border-top:1px solid #e9e9e3;min-height:48px}.ds-links a{display:flex;align-items:center;color:inherit}.ds-nav a:hover{text-decoration:underline;text-underline-offset:5px}.ds-nav a:focus-visible{outline:3px solid #aa3023;outline-offset:4px}.ds-links [aria-current]{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:7px}"
    },
    {
      "name": "Part System Shortcut",
      "kind": "chip",
      "refersTo": "chip-part-system",
      "description": "A requirement shortcut with an outlined tool-like shape; no selected state.",
      "html": "<button class=\"ds-part-system\" type=\"button\">Braking system</button>",
      "css": ".ds-part-system{background:transparent;border:1px solid #989c8e;padding:10px 14px;min-height:44px;border-radius:4px;color:#20221f;cursor:pointer;font:400 12px Manrope,sans-serif}.ds-part-system:focus-visible{outline:3px solid #aa3023;outline-offset:4px}"
    },
    {
      "name": "Raised Finder Panel",
      "kind": "card",
      "refersTo": "finder-panel",
      "description": "White structural requirement-capture panel.",
      "html": "<section class=\"ds-finder\"><h2>Find Your Part</h2><p>Describe your requirement.</p><a href=\"#enquiry\">Send Your Enquiry</a></section>",
      "css": ".ds-finder{background:#fff;color:#20221f;border:1px solid #e1e2db;border-radius:8px;padding:36px;box-shadow:0 16px 48px #20221f12;font:400 16px/1.7 Manrope,sans-serif}.ds-finder h2{font-size:38px;line-height:1.13;letter-spacing:-.035em}.ds-finder a{color:#20221f;background:#ffcc05;padding:14px 22px;border-radius:4px;display:inline-flex;font-size:14px;font-weight:750}.ds-finder a:hover{background:#eabc00}.ds-finder a:focus-visible{outline:3px solid #aa3023;outline-offset:4px}"
    },
    {
      "name": "Sales Utility",
      "kind": "custom",
      "refersTo": "control-sales",
      "description": "The contact primitive rendered in flow for the panel; live placement is fixed and moves into the mobile header.",
      "html": "<a class=\"ds-sales\" href=\"#ds-sales\" aria-label=\"WhatsApp Sales (opens WhatsApp)\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"/></svg><span>WhatsApp Sales</span></a>",
      "css": ".ds-sales{display:inline-flex;align-items:center;gap:10px;background:#225c3c;color:#fff;padding:14px 18px;border-radius:8px;font:700 12px Manrope,sans-serif;box-shadow:0 5px 18px #20221f26;min-height:48px;text-decoration:none}.ds-sales:hover{background:#18462c}.ds-sales:focus-visible{outline:3px solid #aa3023;outline-offset:4px}@media(max-width:1100px){.ds-sales{padding:12px 14px}}@media(max-width:600px){.ds-sales{width:48px;height:48px;padding:12px;justify-content:center}.ds-sales span{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}.ds-sales svg{flex:none}}"
    }
