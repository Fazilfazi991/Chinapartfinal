# Populate through the hosting dashboard or local environment; never send secrets in chat.
# Leave submission disabled until schema, policies, staff and anti-abuse are verified.
CPS_BACKEND=supabase
CPS_SUBMISSIONS_ENABLED=false
CPS_SITE_ORIGIN=
# Exact approved HTTPS origin, with no path or trailing slash.
# Prefer Supabase sb_publishable_ and sb_secret_ keys. Legacy anon/service_role
# keys are format-compatible; never put a server key in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CPS_UPLOADS_ENABLED=false
CPS_SCANNER_URL=
CPS_SCANNER_TOKEN=
# Development disk fixtures only. This is ignored in production and is not
# durable hosting storage. Local Supabase loopback URLs are development-only.
CPS_LOCAL_TEST_BACKEND=false
# Synthetic proposal workspace: explicit development + loopback only; always
# blocked in production, even if this flag is accidentally enabled there.
CPS_PREVIEW_ENABLED=false
# Provider reads/writes and invited customer accounts: all additive templates,
# RLS, memberships, site origin and provider acceptance must be verified first.
# Commercial execution and document visibility are independently disabled in code.
CPS_WORKSPACE_READS_ENABLED=false
CPS_WORKSPACE_WRITES_ENABLED=false
CPS_CUSTOMER_AUTH_ENABLED=false
# Enable only after provider recovery template/SMTP/rate-limit acceptance.
CPS_CUSTOMER_RECOVERY_ENABLED=false
# Publication and guest RFQ ownership linking each require separate acceptance.
CPS_PUBLICATION_ENABLED=false
CPS_PUBLIC_CATALOGUE_ENABLED=false
CPS_RFQ_LINKING_ENABLED=false
# Sharing reviewed DRAFTS only; never final issuance. Owner policy must name
# its approval reference and explicitly allow each kind. Leave unset/false.
CPS_DOCUMENT_VISIBILITY_ENABLED=false
CPS_DOCUMENT_POLICY_JSON=
# Enable indexing only after the final public origin/content are approved.
CPS_SEO_ENABLED=false

# Private catalogue photos: requires accepted private bucket + scanner.
# Normalizes PNG/JPEG to scanned PNG; no direct public bucket/object access.
CPS_CATALOGUE_PHOTOS_ENABLED=false
